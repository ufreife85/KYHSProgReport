# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit real secrets.

# Your school-scoped FACTS API key (~108 characters) -- generated in the
# FACTS Developer Portal when you authorize/scope a new API key to your
# school. This is the value sent as the "Ocp-Apim-Subscription-Key"
# header on every request.
#
# This is NOT your developer subscription key (the shorter, ~32-char
# key tied to your developer account). The subscription key is only
# used inside the portal UI to create/authorize an API key like this
# one -- it is never sent to the API itself. If every request comes
# back 401/403, the most common cause is having pasted the subscription
# key here by mistake instead of the API key it was used to generate.
FACTS_API_KEY=

# API version query string FACTS expects on every call.
# Check your FACTS developer portal / API docs for the current value
# (e.g. "1", "1.0", "2024-01-01" -- FACTS does not publish a single default).
FACTS_API_VERSION=1

# Base URL from the OpenAPI spec. Only change this if FACTS gives you a
# different host (e.g. a sandbox/staging environment).
FACTS_BASE_URL=https://api.factsmgt.com

# Your school's numeric FACTS school ID (used for the SchoolTerms lookup).
# Find it via GET /Students or ask your FACTS admin/support contact.
FACTS_SCHOOL_ID=

# Your school's short code as used across most endpoints
# (Courses, GradeLevels, etc. filter by this string, e.g. "MA" or "MAIN").
FACTS_SCHOOL_CODE=
